# ─── Urimai Guide — Environment Variables ─────────────────────────────────────
# Copy this file to .env.local and fill in your real values.
# NEVER commit .env.local to version control.

# ── Next.js ────────────────────────────────────────────────────────────────────
NEXT_PUBLIC_APP_URL=http://localhost:3000

# ── Supabase (Module 1–18 — primary database, storage, realtime) ───────────────
# Get from: https://supabase.com/dashboard → Project Settings → API
NEXT_PUBLIC_SUPABASE_URL=https://<project-ref>.supabase.co
NEXT_PUBLIC_SUPABASE_ANON_KEY=<your-supabase-anon-key>
# Server-side only — bypasses RLS for admin operations
SUPABASE_SERVICE_ROLE_KEY=<your-supabase-service-role-key>
# Direct PostgreSQL connection string (for pgvector / LangChain)
SUPABASE_DB_URL=postgresql://postgres:<password>@db.<project-ref>.supabase.co:5432/postgres

# ── FastAPI Backend (urimai-backend) ───────────────────────────────────────────
NEXT_PUBLIC_API_BASE_URL=http://localhost:8000/api/v1
# Internal service-to-service key (n8n → FastAPI webhooks)
INTERNAL_SERVICE_KEY=<generate-a-random-32-char-secret>

# ── JWT (Module 1 — auth.py) ───────────────────────────────────────────────────
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
SECRET_KEY=<your-jwt-secret-key>
ACCESS_TOKEN_EXPIRE_MINUTES=15
REFRESH_TOKEN_EXPIRE_DAYS=7

# ── MSG91 (Module 1, 5, 7, 12, 13, 14, 15, 16) ────────────────────────────────
# Get from: https://msg91.com/dashboard → API Keys
MSG91_AUTH_KEY=<your-msg91-auth-key>
# Your approved WhatsApp Business number (with country code, no +)
MSG91_WHATSAPP_NUMBER=91XXXXXXXXXX
# Template IDs (create and get approved in MSG91 → Templates → WhatsApp)
MSG91_TEMPLATE_HEARING_7D_EN=<template-id>
MSG91_TEMPLATE_HEARING_7D_TA=<template-id>
MSG91_TEMPLATE_HEARING_1D_EN=<template-id>
MSG91_TEMPLATE_HEARING_1D_TA=<template-id>
MSG91_TEMPLATE_ORDER_RECEIVED_EN=<template-id>
MSG91_TEMPLATE_ORDER_RECEIVED_TA=<template-id>
MSG91_TEMPLATE_TASK_DUE_EN=<template-id>
MSG91_TEMPLATE_TASK_DUE_TA=<template-id>
MSG91_TEMPLATE_COMPLIANCE_WARNING_EN=<template-id>
MSG91_TEMPLATE_COMPLIANCE_WARNING_TA=<template-id>
MSG91_TEMPLATE_COMPLIANCE_DEFAULT_EN=<template-id>
MSG91_TEMPLATE_COMPLIANCE_DEFAULT_TA=<template-id>
MSG91_TEMPLATE_LIMITATION_WARNING_EN=<template-id>
MSG91_TEMPLATE_LIMITATION_WARNING_TA=<template-id>

# ── Firebase (Module 1C, 1D, 12, 13, 14, 16) ──────────────────────────────────
# Get from: https://console.firebase.google.com → Project Settings → General
NEXT_PUBLIC_FIREBASE_API_KEY=<your-firebase-api-key>
NEXT_PUBLIC_FIREBASE_AUTH_DOMAIN=<project-id>.firebaseapp.com
NEXT_PUBLIC_FIREBASE_PROJECT_ID=<project-id>
NEXT_PUBLIC_FIREBASE_STORAGE_BUCKET=<project-id>.appspot.com
NEXT_PUBLIC_FIREBASE_MESSAGING_SENDER_ID=<sender-id>
NEXT_PUBLIC_FIREBASE_APP_ID=<app-id>
# VAPID key for PWA push (Firebase Console → Cloud Messaging → Web Push certificates)
NEXT_PUBLIC_FIREBASE_VAPID_KEY=<your-vapid-key>
# Server key for n8n FCM HTTP node (Firebase Console → Cloud Messaging → Server key)
FIREBASE_FCM_SERVER_KEY=AAAA<your-fcm-server-key>
# Path to Firebase Admin SDK service account JSON (server-side only)
FIREBASE_ADMIN_SDK_PATH=/secrets/firebase-admin-sdk.json

# ── Google Maps Platform (Module 6, 9) ────────────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → Credentials
# Enable: Places API (New), Geocoding API, Distance Matrix API, Maps JavaScript API
# Server key — restrict to your server IP
GOOGLE_MAPS_API_KEY=<your-server-side-maps-api-key>
# Browser key — restrict to your domain
NEXT_PUBLIC_GOOGLE_MAPS_KEY=<your-browser-maps-api-key>

# ── Google OAuth / Calendar (Module 1C, 11E) ──────────────────────────────────
# Get from: https://console.cloud.google.com → APIs & Services → OAuth 2.0 Client IDs
GOOGLE_OAUTH_CLIENT_ID=<your-google-oauth-client-id>
GOOGLE_OAUTH_CLIENT_SECRET=<your-google-oauth-client-secret>
GOOGLE_OAUTH_REDIRECT_URI=http://localhost:3000/api/auth/google/callback

# ── Bhashini / MeitY (Module 2, 10, 13, 15) ───────────────────────────────────
# Register at: https://bhashini.gov.in → API Console → Create Project
BHASHINI_USER_ID=<your-bhashini-user-id>
BHASHINI_ULCA_API_KEY=<your-ulca-api-key>
BHASHINI_INFERENCE_KEY=<your-inference-api-key>
# Pipeline IDs (from Bhashini dashboard after project creation)
BHASHINI_ASR_PIPELINE_ID=<asr-pipeline-id>
BHASHINI_NMT_PIPELINE_ID=<nmt-pipeline-id>
BHASHINI_TTS_PIPELINE_ID=<tts-pipeline-id>

# ── Google Gemini (Module 10, 13, 17) ─────────────────────────────────────────
# Get from: https://aistudio.google.com → Get API Key
GEMINI_API_KEY=<your-gemini-api-key>
GEMINI_MODEL=gemini-1.5-pro

# ── Redis / Celery (Module 4, 8, 10, 13, 15, 17) ──────────────────────────────
# Local: docker run -d -p 6379:6379 redis:7
# Production: Redis Cloud or Google Memorystore
REDIS_URL=redis://localhost:6379/0
CELERY_BROKER_URL=redis://localhost:6379/0
CELERY_RESULT_BACKEND=redis://localhost:6379/1

# ── n8n Automation (Module 5, 7, 11, 12, 13, 14, 15, 16, 17) ─────────────────
# Self-hosted n8n: docker run -d -p 5678:5678 n8nio/n8n
N8N_BASE_URL=http://localhost:5678
# Webhook URLs (copy from n8n Webhook node → Production URL after activating)
N8N_CASE_SYNC_WEBHOOK=http://localhost:5678/webhook/case-sync-trigger
N8N_ORDER_NOTIFICATION_WEBHOOK=http://localhost:5678/webhook/order-notification
# n8n basic auth (set in n8n environment: N8N_BASIC_AUTH_USER / N8N_BASIC_AUTH_PASSWORD)
N8N_WEBHOOK_SECRET=<generate-a-random-secret-for-webhook-verification>

# ── AES-256 Encryption (Module 1 — PII fields) ────────────────────────────────
# Used to encrypt mobile_number, google_access_token, e-Jagriti credentials
# Generate with: python -c "import secrets; print(secrets.token_hex(32))"
AES_ENCRYPTION_KEY=<your-32-byte-hex-encryption-key>

# ── Slack (Sync Error Handler — n8n Workflow 9) ────────────────────────────────
# Get from: https://api.slack.com/apps → Incoming Webhooks
SLACK_OPS_WEBHOOK_URL=https://hooks.slack.com/services/T000/B000/XXXXX

# ── Vercel Analytics (optional) ───────────────────────────────────────────────
# Automatically injected by Vercel — no manual setup needed in production
